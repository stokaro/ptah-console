{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ptah-console-agent values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "installationID",
    "connection",
    "console",
    "credential",
    "namespaces",
    "accounts"
  ],
  "definitions": {
    "label": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
    },
    "cidrs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-fA-F.:]+/[0-9]{1,3}$"
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      }
    }
  },
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "installationID": {
      "$ref": "#/definitions/label"
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid",
        "generation"
      ],
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "serverName",
        "caBundle"
      ],
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^https://[^/?#@\\s]+/?$"
        },
        "serverName": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "caBundle": {
          "type": "string",
          "pattern": "-----BEGIN CERTIFICATE-----"
        }
      }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secretName",
        "key"
      ],
      "properties": {
        "secretName": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "pattern": "^[-._a-zA-Z0-9]+$"
        }
      }
    },
    "namespaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/label"
      }
    },
    "accounts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "roles"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/label"
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "viewer",
                "plan-reader",
                "desired-state-author",
                "diagnostic-reader",
                "approver"
              ]
            }
          }
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "apiServer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidrs": {
              "$ref": "#/definitions/cidrs"
            },
            "ports": {
              "$ref": "#/definitions/ports"
            }
          }
        },
        "console": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidrs": {
              "$ref": "#/definitions/cidrs"
            },
            "ports": {
              "$ref": "#/definitions/ports"
            }
          }
        }
      }
    },
    "approverClusterRole": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "^(cluster-admin|admin|edit|system:.*)$"
      }
    }
  }
}
