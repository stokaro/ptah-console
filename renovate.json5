{
  // Renovate does nothing until the GitHub App is installed on the repository;
  // this file is what it reads once it is.
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':dependencyDashboard',
    ':semanticCommitsDisabled',
    'helpers:pinGitHubActionDigests',
  ],
  // Plain imperative subjects, as `git log` shows.
  commitMessageAction: 'Update',
  timezone: 'Europe/Prague',
  schedule: ['before 6am on monday'],
  prConcurrentLimit: 4,
  postUpdateOptions: ['gomodTidy'],
  packageRules: [
    {
      matchManagers: ['github-actions'],
      groupName: 'GitHub Actions',
    },
    {
      // The Kubernetes libraries move together. go get of a new operator
      // raises them to at least the versions the operator's go.mod uses.
      matchManagers: ['gomod'],
      matchPackageNames: ['k8s.io/**', 'sigs.k8s.io/**'],
      groupName: 'Kubernetes libraries',
    },
    {
      // The Operator update workflow keeps the one pull request that moves
      // the operator, with the record, charts and goldens a move needs.
      matchManagers: ['gomod'],
      matchPackageNames: ['github.com/stokaro/ptah-operator'],
      enabled: false,
    },
    {
      matchManagers: ['npm'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'web dependencies',
    },
  ],
}
