engine-strict=true
fund=false
# eslint-plugin-react 7.37.5 and eslint-plugin-jsx-a11y 6.10.2 declare
# `eslint: ^3 ... ^9` and run on ESLint 10, as they do in
# denisvmedia/inventario. The mismatch is metadata only: eslint.config.js pins
# the React version so eslint-plugin-react never reaches the API ESLint 10
# removed. Drop this once both publish an ESLint 10 peer range.
legacy-peer-deps=true
